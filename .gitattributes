# newline conversion. Three legacy Apify snapshots and the owner treasury anchor
# were originally hashed on Windows CRLF bytes, so their checkout representation
# is fixed explicitly to CRLF on every platform.
artifacts/evidence/** -text
evidence/audits/** -text
artifacts/market_data/** -text
receipts/execution/** -text

artifacts/evidence/apify_store/snapshot-20260821T194047Z.json text eol=crlf
